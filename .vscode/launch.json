{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug with DAPLink",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/project.elf",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "openocd",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32f1x.cfg"
            ],
            "armToolchainPath": "D:/arm-toolchain/arm-gnu-toolchain-11.3.rel1-mingw-w64-i686-arm-none-eabi/bin",
            "gdbPath": "D:/arm-toolchain/arm-gnu-toolchain-11.3.rel1-mingw-w64-i686-arm-none-eabi/bin/arm-none-eabi-gdb.exe"
        }
    ]
}